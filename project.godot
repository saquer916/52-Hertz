[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="whale"
3d_physics/layer_3="pod"

[physics]

common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=1

[shader_globals]

displacements={
"type": "sampler2DArray",
"value": ""
}
normals={
"type": "sampler2DArray",
"value": ""
}
water_color={
"type": "color",
"value": Color(0.0100228, 0.0196066, 0.0272118, 1)
}
foam_color={
"type": "color",
"value": Color(0, 0, 0, 1)
}
num_cascades={
"type": "uint",
"value": 0
}
